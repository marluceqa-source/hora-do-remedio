# Copie para .env e ajuste se seus endereços/caminhos forem diferentes.

# Portal web (frontend Vite)
WEB_BASE_URL=http://localhost:5173

# API REST (FastAPI)
API_BASE_URL=http://localhost:8000

# Pasta da aplicação sob teste.
# Este branch tem apenas os testes: aponte para onde a aplicação (o main) está clonada.
# Exemplo com os dois lado a lado:  ../../../aplicacao
APP_DIR=../..

# Python do ambiente virtual da aplicação (usado para subir a API e rodar as migrações).
# Por padrão é o .venv de dentro do APP_DIR.
PYTHON_BIN=../../.venv/bin/python

# Banco SQLite exclusivo da automação (não mexe no banco de desenvolvimento)
TEST_DATABASE_URL=sqlite:///./database/playwright_test.db

# Limite de requisições por minuto da API durante os testes
TEST_RATE_LIMIT_PER_MINUTE=1000

# 1 = a automação sobe API e portal sozinha; 0 = você já subiu os dois na mão
START_SERVERS=1
