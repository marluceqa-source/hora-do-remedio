{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hora-do-remedio-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "source .venv/bin/activate && uvicorn api.main:app --host 0.0.0.0 --port 8000"],
      "port": 8000
    },
    {
      "name": "hora-do-remedio-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --host"],
      "port": 5173
    }
  ]
}
