# Hora do Remédio — variáveis de ambiente de exemplo
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA versione o arquivo ".env" com segredos reais.

# --- Geral ---
APP_NAME="Hora do Remédio"
APP_ENV=development
TIMEZONE=America/Sao_Paulo
LOCALE=pt-BR

# --- Bot Telegram ---
# Obtenha o token criando um bot com o @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=coloque_aqui_o_token_do_botfather

# --- Banco de dados ---
# Desenvolvimento: SQLite local. Produção: avaliar PostgreSQL (ver docs/architecture.md).
DATABASE_URL=sqlite:///./database/hora_do_remedio.db

# --- Segurança da API (independente do token do bot) ---
# Gere um valor novo com:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Com APP_ENV diferente de development/dev/local/test/testing, a aplicação se recusa a
# iniciar enquanto este valor for de exemplo, vazio ou menor que 32 caracteres.
API_SECRET_KEY=troque_por_uma_chave_aleatoria_forte
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Limitação de requisições ---
RATE_LIMIT_PER_MINUTE=60

# --- Retenção de dados (LGPD) ---
DATA_RETENTION_DAYS=365

# --- OCR (local/offline — Tesseract) ---
OCR_ENGINE=tesseract
OCR_LANGUAGE=por
# Caminho do binário do tesseract, caso não esteja no PATH do sistema.
TESSERACT_CMD=

# --- Speech-to-Text (local/offline — faster-whisper) ---
STT_ENGINE=faster-whisper
STT_MODEL_SIZE=small
STT_LANGUAGE=pt

# --- Text-to-Speech (local/offline — pyttsx3, usa voz nativa do SO em pt-BR) ---
TTS_ENGINE=pyttsx3
# Nome/id da voz do sistema a usar (vazio = primeira voz pt-BR encontrada automaticamente).
TTS_VOICE_NAME=

# --- Logs ---
LOG_LEVEL=INFO
LOG_FILE=./logs/hora_do_remedio.log

# --- API (host/porta para execução local) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Portal web de profissionais de saúde ---
# Segredo para assinar o cookie de sessão/pré-autenticação. Gere com o mesmo comando do
# API_SECRET_KEY, mas um valor DIFERENTE: a autenticação do paciente e a do profissional
# são independentes de propósito (RN19), e repetir o segredo anula essa separação — a
# aplicação se recusa a iniciar fora de desenvolvimento se os dois forem iguais.
PROFESSIONAL_SESSION_SECRET_KEY=troque_por_outra_chave_aleatoria_forte
PROFESSIONAL_SESSION_COOKIE_NAME=hdr_professional_session
PROFESSIONAL_SESSION_EXPIRE_MINUTES=480
PROFESSIONAL_MFA_PRE_AUTH_EXPIRE_MINUTES=5
PROFESSIONAL_MAX_FAILED_LOGINS=5
PROFESSIONAL_LOCKOUT_MINUTES=15
PROFESSIONAL_PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Vínculo paciente ↔ Telegram (RF04) ---
PATIENT_INVITE_EXPIRE_MINUTES=30
# @usuario do bot (sem o @), só para montar o link https://t.me/usuario?start=TOKEN no portal.
TELEGRAM_BOT_USERNAME=

# --- Portal web — CORS (origens do frontend, separadas por vírgula) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
